# ──────────────────────────────────────────────────────────────────────────────
# osint-investigator — environment template
# Copy this file to `.env` and fill in any keys you have. Everything is OPTIONAL;
# the tool will degrade gracefully if a key is missing.
# ──────────────────────────────────────────────────────────────────────────────

# Have I Been Pwned (https://haveibeenpwned.com/API/Key) — required for `breach`
HIBP_API_KEY=

# Hunter.io (https://hunter.io/api) — optional email enrichment
HUNTER_API_KEY=

# IntelX (https://intelx.io/account?tab=developer) — optional leak search
INTELX_API_KEY=

# ── Polite scraping defaults ──────────────────────────────────────────────────
# User-Agent string sent with every HTTP request.
OSINT_USER_AGENT="osint-investigator/0.1 (+https://github.com/J4y35/osint-investigator)"

# Seconds to sleep between requests against the same host (float).
OSINT_REQUEST_DELAY=1.5

# Per-request timeout in seconds.
OSINT_HTTP_TIMEOUT=20

# Headless Playwright? (true|false). Set to false to watch the browser.
OSINT_PLAYWRIGHT_HEADLESS=true

# Where the tool writes JSON exports / cached HTML. Created on demand.
OSINT_OUTPUT_DIR=./output
